# VibeCut Web local environment
# Copy this file to .env.local and fill in only the services you need.

# Remotion Lambda / AWS rendering
# Leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY blank to use simulated local render jobs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
REMOTION_LAMBDA_FUNCTION=
REMOTION_S3_BUCKET=
REMOTION_SERVE_URL=

# Creative provider API keys are configured in the app at /settings and stored in browser localStorage.
# Do not put browser-only provider keys in this file unless a server route explicitly needs them.
